{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "declaration": true,
        "jsx": "react-jsx",
        "lib": ["es2020", "dom", "dom.iterable"],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "paths": {
            "invisible-wallet-sdk/vanilla": [
                "./src/vanilla"
            ]
        }
    },
    "include": [
        "src/**/*",
        "react/**/*",
        "angular/**/*"
    ],
    "exclude": [
        "src/**/*.native.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "react/src/**/*.test.ts",
        "react/src/**/*.test.tsx"
    ]
}

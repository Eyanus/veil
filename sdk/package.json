{
  "name": "invisible-wallet-sdk",
  "version": "0.1.0",
  "description": "Client SDK for Invisible Wallet (Soroban + WebAuthn) — supports Web and React Native",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "react-native": "src/index.ts",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./vanilla": {
      "types": "./dist/src/vanilla.d.ts",
      "react-native": "./src/vanilla.ts",
      "default": "./dist/src/vanilla.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./angular": {
      "types": "./dist/angular/src/public-api.d.ts",
      "default": "./dist/angular/src/public-api.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && node scripts/flatten-dist.js",
    "test": "jest",
    "size": "npm run build && size-limit",
    "test:surface": "jest api-surface.test.ts",
    "stryker": "stryker run"
  },
  "keywords": [
    "stellar",
    "soroban",
    "webauthn",
    "passkeys",
    "wallet",
    "react-native",
    "expo"
  ],
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^14.6.1"
  },
  "peerDependencies": {
    "@angular/core": ">=16.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-passkey": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-passkey": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^22.0.3",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "fast-check": "^4.8.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-util": "^29.7.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "size-limit": "^12.1.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx",
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@stellar/stellar-sdk$": "<rootDir>/node_modules/@stellar/stellar-sdk"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "strict": true,
            "esModuleInterop": true,
            "skipLibCheck": true
          }
        }
      ]
    }
  },
  "size-limit": [
    {
      "name": "main (React hook + utils)",
      "path": "dist/src/index.js",
      "limit": "230 KB"
    },
    {
      "name": "vanilla",
      "path": "dist/src/vanilla.js",
      "limit": "225 KB"
    }
  ]
}
